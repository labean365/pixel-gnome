# EditorConfig — https://editorconfig.org
# Keeps indent style, line endings, and encoding consistent
# for anyone cloning the repo, regardless of editor.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Preserve Markdown's significant trailing spaces (2 spaces = <br>).
[*.md]
trim_trailing_whitespace = false
