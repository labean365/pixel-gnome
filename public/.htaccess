# PixelGnome cache policy — for Apache static hosting.
#
# Strategy: default every response to "revalidate on each load" so a new deploy
# reaches returning visitors immediately (this also covers the bare "/" request,
# which serves index.html via DirectoryIndex and is NOT caught by a .html match).
# Then override with long, immutable caching for the content-hashed build assets
# in /assets/, whose filenames change whenever their contents do.
#
# The <IfModule> guard means these rules are silently skipped (no 500) if
# mod_headers is unavailable.

# WebAssembly MUST be served as application/wasm, or WebAssembly.instantiateStreaming
# rejects ("Incorrect response MIME type") — which is what stalled the PDF worker
# (MuPDF's non-streaming fallback then hangs). The host returned no Content-Type
# for .wasm, so set it explicitly.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  # Default for everything (incl. "/" and *.html): always revalidate.
  Header set Cache-Control "no-cache, must-revalidate"

  # Content-hashed JS/CSS/fonts/wasm (Vite fingerprints these) — cache for a year.
  <FilesMatch "\.(js|css|woff2?|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Icons / images (not fingerprinted) — cache a day.
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # robots.txt / sitemap.xml — cache an hour.
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
