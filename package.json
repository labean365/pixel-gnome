{
  "name": "pixel-gnome",
  "private": true,
  "version": "0.31.5",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "321Enterprise (https://321enterprise.com/)",
  "homepage": "https://pixelgnome.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/labean365/pixel-gnome.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --config vite.singlefile.config.js && node scripts/cleanup-singlefile.mjs",
    "build:all": "vite build && vite build --config vite.singlefile.config.js",
    "check:pdf": "node scripts/check-pdf-build.mjs dist && node scripts/check-pdf-build.mjs dist-single --single",
    "check:pdf-engine": "node scripts/check-pdf-engine.mjs",
    "verify": "npm run lint && npm run format:check && npm run build:all && npm run check:pdf && npm run check:pdf-engine",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "heic-to": "^1.6.5",
    "jszip": "^3.10.2",
    "mupdf": "^1.28.1"
  }
}
